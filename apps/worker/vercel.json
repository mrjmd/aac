{
  "buildCommand": "cd ../.. && pnpm turbo build --filter=@aac/worker",
  "outputDirectory": ".",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 300,
      "memory": 256
    }
  },
  "crons": [
    {
      "path": "/api/tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/sweep",
      "schedule": "*/10 * * * *"
    }
  ]
}
