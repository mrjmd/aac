{
  "buildCommand": "cd ../.. && pnpm turbo build --filter=@aac/worker",
  "outputDirectory": ".",
  "functions": {
    "api/quote-tick.ts": {
      "maxDuration": 800,
      "memory": 1024
    },
    "api/quote-draft.ts": {
      "maxDuration": 800,
      "memory": 1024
    },
    "api/**/*.ts": {
      "maxDuration": 300,
      "memory": 256
    }
  },
  "crons": [
    {
      "path": "/api/tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/sweep",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/quote-tick",
      "schedule": "* * * * *"
    }
  ]
}
