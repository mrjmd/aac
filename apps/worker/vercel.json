{
  "buildCommand": "cd ../.. && pnpm turbo build --filter=@aac/worker",
  "outputDirectory": ".",
  "functions": {
    "api/quote-tick.ts": {
      "maxDuration": 800,
      "memory": 1024
    },
    "api/quote-draft.ts": {
      "maxDuration": 800,
      "memory": 1024
    },
    "api/ads-conversions.ts": {
      "maxDuration": 800,
      "memory": 512
    },
    "api/inbound-tick.ts": {
      "maxDuration": 800,
      "memory": 1024
    },
    "api/stale-quotes.ts": {
      "maxDuration": 800,
      "memory": 512
    },
    "api/triage.ts": {
      "maxDuration": 800,
      "memory": 1024
    },
    "api/**/*.ts": {
      "maxDuration": 300,
      "memory": 256
    }
  },
  "crons": [
    {
      "path": "/api/tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/sweep",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/quote-tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/quote-email-tick",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/watchdog",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/ads-conversions",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/inbound-tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/stale-quotes",
      "schedule": "0,20,40 12 * * *"
    },
    {
      "path": "/api/triage",
      "schedule": "5 13 * * *"
    }
  ]
}
