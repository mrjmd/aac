{
  "name": "@aac/quoting",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./can-help": "./dist/can-help.js"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/data && cp -f src/data/*.json dist/data/",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aac/api-clients": "workspace:*",
    "@aac/customers": "workspace:*",
    "@aac/shared-utils": "workspace:*"
  },
  "devDependencies": {
    "@aac/tsconfig": "workspace:*",
    "@types/node": "^22",
    "typescript": "^5.8",
    "vitest": "^3.2.6"
  }
}
